# 운영 서버(EC2)의 compose.prod.yaml 옆에 .env 라는 이름으로 두고 실제 값을 채운다.
# 이 파일 자체는 예시이므로 실제 값을 적어 커밋하지 않는다.

# GitHub Actions가 GHCR에 올린 이미지. :latest 대신 커밋 SHA 태그를 쓰면 배포 버전을 고정할 수 있다
BACKEND_IMAGE=ghcr.io/dayro-dev/dayro-backend:latest

# 도메인 연결 전에는 :80 (HTTP만). 도메인이 생기면 api.example.com 형태로 바꾸면 인증서가 자동 발급된다
SITE_ADDRESS=:80

# DB - 로컬 개발용 dayro/dayro를 그대로 쓰지 말고 긴 임의 문자열로 채운다
POSTGRES_DB=dayro
POSTGRES_USER=dayro
POSTGRES_PASSWORD=

# 외부 API 키
SPRING_AI_GOOGLE_GENAI_API_KEY=
GOOGLE_PLACES_API_KEY=

# 최소 32바이트 이상 (JwtProvider가 HMAC 서명키를 만든다)
JWT_SECRET_KEY=

# 카카오 - redirect-uri는 카카오 개발자 콘솔에 등록된 운영 주소와 정확히 일치해야 한다
KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=
KAKAO_REDIRECT_URI=
KAKAO_ADMIN_KEY=

# 외부 유료 API 일일 하드 캡 - 비워두면 애플리케이션 기본값(350 / 300 / 60)이 쓰인다
QUOTA_PLACES_DAILY_LIMIT=350
QUOTA_PLACES_PHOTO_DAILY_LIMIT=300
QUOTA_PLACES_PHOTO_PER_IP_LIMIT=60
